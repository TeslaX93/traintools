<!DOCTYPE html>
<html lang="pl">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>{% block title %}KalkulatorKolejowy.pl{% endblock %}</title>
        <meta name="description" content="{% block description %}Narzędzia dla miłośników kolei: odległości między stacjami, mapa stacji kolejowych, tablice relacyjne i API z opóźnieniami pociągów.{% endblock %}">
        <link rel="canonical" href="{{ absolute_url(app.request.pathinfo) }}">

        {# Open Graph - decyduje, jak wyglada link wklejony na forum czy Facebooka #}
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="KalkulatorKolejowy.pl">
        <meta property="og:locale" content="pl_PL">
        <meta property="og:title" content="{{ block('title')|striptags|trim }}">
        <meta property="og:description" content="{{ block('description')|striptags|trim }}">
        <meta property="og:url" content="{{ absolute_url(app.request.pathinfo) }}">
        <meta property="og:image" content="{{ absolute_url(asset('img/og-default.png')) }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta name="twitter:card" content="summary_large_image">

        <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="32x32">
        <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
        <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}">
        <link rel="manifest" href="{{ asset('site.webmanifest') }}">
        <meta name="theme-color" content="#0b3d6b">

        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" integrity="sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N" crossorigin="anonymous">
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-XRTNWQFWN1"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());

            gtag('config', 'G-XRTNWQFWN1');
        </script>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}

        {# biblioteki musza byc zaladowane PRZED skryptami podstron #}
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>

        {% block javascripts %}{% endblock %}
    </body>
</html>
