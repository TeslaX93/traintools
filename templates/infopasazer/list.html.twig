{% extends 'base.html.twig' %}

{% block title %}Infopasazer{% endblock %}

{% block body %}
{% if error %}
    <p class="alert alert-danger">{{ error }}</p>
{% endif %}
<table>
    {% for st in stations|keys %}
        <tr>
            <td>{{ st }}</td>
            <td> {{ stations[st] }}</td>
        </tr>
    {% endfor %}
</table>
{% endblock %}
