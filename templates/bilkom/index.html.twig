{% extends 'base.html.twig' %}

{% block title %}API Bilkom — opóźnienia i odjazdy pociągów{% endblock %}
{% block description %}Darmowe API JSON z tablicą odjazdów i przyjazdów oraz opóźnieniami pociągów dla stacji kolejowych w Polsce. Dokumentacja w standardzie OpenAPI 3.1.{% endblock %}

{% block stylesheets %}
<style>
    .api-naglowek {
        max-width: 60rem;
        margin: 0 auto;
        padding: 2rem 1rem 1rem;
    }

    .api-naglowek h1 {
        margin: 0;
        font-size: clamp(1.5rem, 4vw, 2.2rem);
        font-weight: 600;
        letter-spacing: -0.02em;
    }

    .api-naglowek p {
        margin: 0.5rem 0 0;
        color: #4b5563;
    }

    .api-linki {
        margin: 1rem 0 0;
        padding: 0;
        list-style: none;
        display: flex;
        gap: 1.25rem;
        flex-wrap: wrap;
        font-size: 0.9rem;
    }

    .api-fallback {
        max-width: 60rem;
        margin: 0 auto;
        padding: 1rem;
        color: #6b7280;
        font-size: 0.9rem;
    }

    redoc {
        display: block;
        border-top: 1px solid #e5e7eb;
        margin-top: 1.5rem;
    }
</style>
{% endblock %}

{% block body %}
<div class="api-naglowek">
    <h1>API Bilkom</h1>
    <p>
        Tablice odjazdów i przyjazdów pociągów wraz z aktualnymi opóźnieniami,
        w formacie JSON. Bez klucza, bez rejestracji.
    </p>
    <ul class="api-linki">
        <li><a href="{{ asset('openapi.yaml') }}">Specyfikacja OpenAPI 3.1 (YAML)</a></li>
        <li><a href="{{ path('app_bilkom_example1') }}">Przykład: najbliższy odjazd z Wrocławia Głównego</a></li>
        <li><a href="/bilkom/api/nextdeparture/basic/5100069">Surowa odpowiedź JSON</a></li>
    </ul>
</div>

<div class="api-fallback" id="api-fallback">
    Wczytywanie dokumentacji… Jeżeli nic się nie pojawi, cała specyfikacja jest
    dostępna jako <a href="{{ asset('openapi.yaml') }}">plik OpenAPI</a> —
    otworzy ją każde narzędzie zgodne ze standardem, na przykład Swagger Editor.
</div>

<redoc spec-url="{{ asset('openapi.yaml') }}" hide-download-button></redoc>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.redoc.ly/redoc/v2.1.5/bundles/redoc.standalone.js"></script>
<script>
    // komunikat zastepczy znika dopiero, gdy Redoc faktycznie sie zaladowal
    window.addEventListener('load', function () {
        var fallback = document.getElementById('api-fallback');
        if (fallback && window.customElements && window.customElements.get('redoc')) {
            fallback.remove();
        }
    });
</script>
{% endblock %}
