{% extends 'base.html.twig' %}

{% block title %}API — odjazdy pociągów i katalogi stacji{% endblock %}
{% block description %}Darmowe API JSON: tablice odjazdów i przyjazdów z opóźnieniami oraz katalogi stacji kolejowych w Polsce. Dokumentacja w standardzie OpenAPI 3.1, z możliwością wywołania endpointów wprost ze strony.{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://unpkg.com/swagger-ui-dist@5.17.14/swagger-ui.css">
<style>
    .api-naglowek {
        max-width: 60rem;
        margin: 0 auto;
        padding: 2rem 1rem 0.5rem;
    }

    .api-naglowek h1 {
        margin: 0;
        font-size: clamp(1.5rem, 4vw, 2.2rem);
        font-weight: 600;
        letter-spacing: -0.02em;
    }

    .api-naglowek p {
        margin: 0.5rem 0 0;
        color: #4b5563;
    }

    .api-linki {
        margin: 1rem 0 0;
        padding: 0;
        list-style: none;
        display: flex;
        gap: 1.25rem;
        flex-wrap: wrap;
        font-size: 0.9rem;
    }

    .api-fallback {
        max-width: 60rem;
        margin: 0 auto;
        padding: 1rem;
        color: #6b7280;
        font-size: 0.9rem;
    }

    /* Swagger UI dubluje tytul i opis, ktore mamy juz we wlasnym naglowku */
    #swagger-ui .information-container {
        display: none;
    }

    #swagger-ui .swagger-ui .wrapper {
        max-width: 62rem;
    }
</style>
{% endblock %}

{% block body %}
<div class="api-naglowek">
    <h1>API KalkulatorKolejowy.pl</h1>
    <p>
        Tablice odjazdów i przyjazdów pociągów wraz z opóźnieniami oraz katalogi
        stacji kolejowych, w formacie JSON. Bez klucza, bez rejestracji.
        Każdy endpoint można wywołać wprost z tej strony przyciskiem „Try it out”.
    </p>
    <ul class="api-linki">
        <li><a href="{{ asset('openapi.yaml') }}">Specyfikacja OpenAPI 3.1 (YAML)</a></li>
        <li><a href="{{ path('app_bilkom_example1') }}">Przykład użycia: najbliższy odjazd z Wrocławia Głównego</a></li>
    </ul>
</div>

<div class="api-fallback" id="api-fallback">
    Wczytywanie dokumentacji… Jeżeli nic się nie pojawi, cała specyfikacja jest
    dostępna jako <a href="{{ asset('openapi.yaml') }}">plik OpenAPI</a> —
    otworzy ją każde narzędzie zgodne ze standardem, na przykład Swagger Editor.
</div>

<div id="swagger-ui"></div>
{% endblock %}

{% block javascripts %}
<script src="https://unpkg.com/swagger-ui-dist@5.17.14/swagger-ui-bundle.js"></script>
<script>
    (function () {
        var cel = document.getElementById('swagger-ui');
        var fallback = document.getElementById('api-fallback');

        if (typeof SwaggerUIBundle !== 'function') {
            if (fallback) {
                fallback.textContent = 'Nie udalo sie wczytac widoku dokumentacji. '
                    + 'Specyfikacja jest dostepna pod adresem /openapi.yaml.';
            }
            return;
        }

        SwaggerUIBundle({
            url: '{{ asset('openapi.yaml') }}',
            dom_id: '#swagger-ui',
            deepLinking: true,
            docExpansion: 'list',
            defaultModelsExpandDepth: 1,
            tryItOutEnabled: true,
            supportedSubmitMethods: ['get'],
            onComplete: function () {
                if (fallback) {
                    fallback.remove();
                }
            }
        });

        // zabezpieczenie, gdyby onComplete nie wystartowal
        setTimeout(function () {
            if (fallback && cel.children.length > 0) {
                fallback.remove();
            }
        }, 8000);
    })();
</script>
{% endblock %}
